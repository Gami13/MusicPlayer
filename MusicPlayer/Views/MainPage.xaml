<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="MusicPlayer.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:icon="clr-namespace:IconPacks.IconKind;assembly=IconPacks.MaterialCommunity"
	xmlns:local="clr-namespace:MusicPlayer"
	xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui">


	<ScrollView>

		<mdc:Card BackgroundColor="{DynamicResource SurfaceContainerColor}"
				  HorizontalOptions="Fill"
				  Padding="4">


			<ListView SelectionMode="None"
					  x:Name="SongsList"
					  RowHeight="116">
				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>
							<Grid Padding="6,6"
								  Margin="0,4"
								  RowSpacing="6"
								  ColumnSpacing="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="64"/>

								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="20"/>
									<RowDefinition Height="*"/>

								</Grid.RowDefinitions>
								<Border Grid.Column="0"
										Grid.RowSpan="2"
										Stroke="Transparent"
										StrokeShape="RoundRectangle 12"
										Margin="0,0,0,0"
										StrokeThickness="0">
									<Image
										WidthRequest="100"
										Aspect="AspectFill"
										HeightRequest="100"/>
								</Border>
								<Label Grid.Column="1"
									   TextColor="{DynamicResource PrimaryColor}"
									   Grid.ColumnSpan="2"
									   FontSize="18"
									   FontAttributes="Bold"
									   Text="{Binding Title}"/>
								<StackLayout Grid.Column="1"
											 TranslationX="-8"
											 VerticalOptions="Center"
											 Spacing="8"
											 Scale="0.9"
											 Grid.RowSpan="1"
											 Grid.Row="1"
											 Orientation="Vertical">



								</StackLayout>

							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</mdc:Card>
	</ScrollView>
</ContentView>
