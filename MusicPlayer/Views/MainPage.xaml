<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MusicPlayer.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icon="clr-namespace:IconPacks.IconKind;assembly=IconPacks.MaterialCommunity"
    xmlns:local="clr-namespace:MusicPlayer">


    <ScrollView>

        <FlexLayout Direction="Column">
            <Image x:Name="CoverImage"
                   Source="https://i.ytimg.com/vi/kJQP7kiw5Fk/maxresdefault.jpg"
                   Aspect="AspectFill"
                   HeightRequest="200"/>

            <mdc:TextField x:Name="TitleField"/>
            <mdc:TextField x:Name="AlbumField"/>
            <mdc:TextField x:Name="ArtistField"/>
            <mdc:TextField x:Name="GenreField"/>
            <mdc:TextField x:Name="YearField"/>

            <mdc:Button x:Name="DownloadButton"
                        Text="Download"
                        Clicked="DownloadSong"/>
        </FlexLayout>
    </ScrollView>
</ContentView>
