<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="MusicPlayer.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:icon="clr-namespace:IconPacks.IconKind;assembly=IconPacks.MaterialCommunity"
	xmlns:local="clr-namespace:MusicPlayer"
	x:Name="mainPage"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui">


	<ContentView.Resources>
		<ResourceDictionary>
			<toolkit:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter"/>
		</ResourceDictionary>
		<local:TimeConverter x:Key="TimeConverter"/>
		<local:TitleConverter x:Key="TitleConverter"/>
	</ContentView.Resources>
	<Grid>


		<mdc:Card BackgroundColor="{DynamicResource SurfaceContainerColor}"
				  HorizontalOptions="Fill"
				  Padding="4">


			<ListView SelectionMode="None"
					  ItemsSource="{x:Static local:AppState.SongsList}"
					  x:Name="SongsList"
					  RowHeight="68">
				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>

							<Grid Padding="0"
								  BackgroundColor="Transparent"
								  HeightRequest="60"
								  Margin="0,4"
								  RowSpacing="6"
								  ColumnSpacing="0">

								<Grid.Behaviors>
									<!-- Command="{Binding Source={x:Reference mainPage},Path=TapCommand}" -->
									<!-- CommandParameter="{Binding .}" -->

									<toolkit:TouchBehavior
										LongPressCommand="{Binding Source={x:Reference mainPage},Path=LongPressCommand}"
										PressedOpacity="0.5"
										LongPressCommandParameter="{Binding .}"
										DefaultAnimationEasing="{x:Static Easing.CubicInOut}"
										DefaultAnimationDuration="100"
										LongPressDuration="500">

									</toolkit:TouchBehavior>


								</Grid.Behaviors>
								<Grid.GestureRecognizers>
									<TapGestureRecognizer Tapped="SongTapped"
														  BindingContext="{Binding .}"/>

								</Grid.GestureRecognizers>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="60"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="64"/>

								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="*"/>

								</Grid.RowDefinitions>

								<Border Grid.Column="0"
										HeightRequest="60"
										WidthRequest="60"
										Stroke="Transparent"
										StrokeShape="RoundRectangle 8"
										Margin="0,0,0,0"
										StrokeThickness="0">
									<Image Source="{Binding Cover, Converter={StaticResource ByteArrayToImageSourceConverter}}"
										   Aspect="AspectFill"/>
								</Border>





								<StackLayout Grid.Column="1"
											 VerticalOptions="Center"
											 Spacing="4"
											 Scale="0.9"
											 Grid.RowSpan="1"
											 Grid.Row="1"
											 Orientation="Vertical">

									<Label Grid.Column="1"
										   TextColor="{DynamicResource PrimaryColor}"
										   Grid.ColumnSpan="2"
										   FontSize="18"
										   FontAttributes="Bold"
										   Text="{Binding Title,Converter={StaticResource TitleConverter}}"/>
									<HorizontalStackLayout Spacing="4">

										<Label Text="{Binding Artist}"
											   TextColor="{DynamicResource OnSurfaceColor}"
											   FontSize="16"/>
										<Label Text="•"
											   FontSize="16"
											   TextColor="{DynamicResource OnSurfaceColor}"
											   FontFamily="monospace"
											   FontAttributes="Bold"/>
										<Label Text="{Binding Duration,Converter={StaticResource TimeConverter}}"
											   TextColor="{DynamicResource OnSurfaceColor}"
											   FontSize="16"/>

									</HorizontalStackLayout>

								</StackLayout>
								<mdc:IconButton Grid.Column="2"
												Clicked="Favorite"
												BindingContext="{Binding .}"
												Style="{DynamicResource StandardIconButtonStyle}"
												IconData="{x:Static icon:MaterialCommunity.HeartOutline}">
									<mdc:IconButton.Triggers>
										<DataTrigger TargetType="mdc:IconButton"
													 Binding="{Binding IsFavorite}"
													 Value="True">
											<Setter Property="IconData"
													Value="{x:Static icon:MaterialCommunity.Heart}"/>

										</DataTrigger>
										<DataTrigger TargetType="mdc:IconButton"
													 Binding="{Binding IsFavorite}"
													 Value="False">
											<Setter Property="IconData"
													Value="{x:Static icon:MaterialCommunity.HeartOutline}"/>

										</DataTrigger>
									</mdc:IconButton.Triggers>
								</mdc:IconButton>

							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>

			</ListView>
		</mdc:Card>

	</Grid>
</ContentView>
