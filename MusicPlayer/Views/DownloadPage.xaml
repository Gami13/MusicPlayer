<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MusicPlayer.DownloadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icon="clr-namespace:IconPacks.IconKind;assembly=IconPacks.MaterialCommunity"
    xmlns:local="clr-namespace:MusicPlayer">
    <ScrollView>
        <VerticalStackLayout Spacing="8">
            <Border
                Margin="16,0"
                Stroke="transparent"
                StrokeShape="RoundRectangle 12,12,12,12">

                <Image
                    x:Name="CoverImage"
                    Aspect="AspectFill"
                    HeightRequest="200"
                    Source="https://i.ytimg.com/vi/kJQP7kiw5Fk/maxresdefault.jpg"/>
            </Border>
            <Border
                HeightRequest="64"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8,8,8,8"
                WidthRequest="360">

                <mdc:TextField
                    x:Name="TitleField"
                    Margin="{OnPlatform WinUI='0,-8,0,0',
                                        Android='0,0,0,-12'}"
                    HeightRequest="88"
                    LabelText="Title"
                    SupportingText=""
                    WidthRequest="360"/>
            </Border>

            <Border
                HeightRequest="64"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8,8,8,8"
                WidthRequest="360">

                <mdc:TextField
                    x:Name="AlbumField"
                    Margin="{OnPlatform WinUI='0,-8,0,0',
                                        Android='0,0,0,-12'}"
                    HeightRequest="88"
                    LabelText="Album"
                    SupportingText=""
                    WidthRequest="360"/>
            </Border>
            <Border
                HeightRequest="64"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8,8,8,8"
                WidthRequest="360">

                <mdc:TextField
                    x:Name="ArtistField"
                    Margin="{OnPlatform WinUI='0,-8,0,0',
                                        Android='0,0,0,-12'}"
                    HeightRequest="88"
                    LabelText="Artist"
                    SupportingText=""
                    WidthRequest="360"/>
            </Border>
            <Border
                HeightRequest="64"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8,8,8,8"
                WidthRequest="360">

                <mdc:TextField
                    x:Name="GenreField"
                    Margin="{OnPlatform WinUI='0,-8,0,0',
                                        Android='0,0,0,-12'}"
                    HeightRequest="88"
                    LabelText="Genre"
                    SupportingText=""
                    WidthRequest="360"/>
            </Border>
            <Border
                HeightRequest="64"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8,8,8,8"
                WidthRequest="360">

                <mdc:TextField
                    x:Name="YearField"
                    Margin="{OnPlatform WinUI='0,-8,0,0',
                                        Android='0,0,0,-12'}"
                    HeightRequest="88"
                    LabelText="Year"
                    SupportingText=""
                    WidthRequest="360"/>
            </Border>
            <!--  Clicked="DownloadSong"  -->
            <mdc:Button x:Name="DownloadButton"
                        Text="Download"
                        Clicked="DownloadSong"/>

            <AbsoluteLayout HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HeightRequest="128"
                            WidthRequest="128">
                <Label
                    AbsoluteLayout.LayoutBounds="0.5,0.5,128,128"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    x:Name="ProgressLabel"
                    TextColor="{DynamicResource PrimaryColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <mdc:ProgressIndicator Style="{DynamicResource CircularProgressIndicatorStyle}"
                                       Percent="0"
                                       x:Name="ProgressIndicator"
                                       ActiveIndicatorHeight="4"
                                       HeightRequest="128"
                                       WidthRequest="128"/>

            </AbsoluteLayout>
        </VerticalStackLayout>

    </ScrollView>
</ContentView>
