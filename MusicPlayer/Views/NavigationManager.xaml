<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MusicPlayer.NavigationManager"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:icon="clr-namespace:IconPacks.IconKind;assembly=IconPacks.MaterialCommunity"
	xmlns:droid="clr-namespace:CommunityToolkit.Maui.PlatformConfiguration.AndroidSpecific;assembly=CommunityToolkit.Maui"
	xmlns:local="clr-namespace:MusicPlayer"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:mdc="clr-namespace:Material.Components.Maui;assembly=Material.Components.Maui"
	droid:NavigationBar.Color="Transparent"
	Padding="{OnPlatform Android='0,32,0,0', WinUI='0,0,0,0'}">
	<ContentPage.Behaviors>
		<toolkit:StatusBarBehavior StatusBarColor="{DynamicResource SurfaceColor}"/>
	</ContentPage.Behaviors>
	<Grid>

		<Grid>

			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>



			<ContentView
				x:Name="NavigationDestinationContent"
				Grid.Row="0"
				Padding="8"
				BackgroundColor="{DynamicResource SurfaceColor}"
				VerticalOptions="Fill"/>


			<ContentView Grid.Row="1">

				<mdc:NavigationBar x:Name="NavigationDrawer"/>
			</ContentView>
		</Grid>
		<!-- TODO: Change InputTransparent -->
		<ContentView x:Name="PopUpLayer"
					 InputTransparent="False">
			<ContentView.GestureRecognizers>
				<TapGestureRecognizer Tapped="PopUpLayerTap"/>
			</ContentView.GestureRecognizers>


		</ContentView>
	</Grid>
</ContentPage>